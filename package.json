{
  "name": "trilha-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dashboard de frequência escolar em React + Node, com leitura de planilhas arquivadas em pasta.",
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js"
  },
  "dependencies": {
    "chart.js": "^4.4.4",
    "express": "^4.19.2",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.0.1",
    "vite": "^8.3.8"
  }
}
